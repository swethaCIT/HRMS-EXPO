# Copy this file to .env in the same directory and fill in real values.
# The real .env is gitignored and must NEVER be committed.
# NOTE: never commit real secrets here — use placeholders only.

NODE_ENV=development
PORT=3000
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated allowed CORS origins (leave blank to allow all in dev)
CORS_ORIGINS=

# Database
# Supabase Postgres — full connection string from the Supabase dashboard
# (Project → Connect → ORMs/URI), SESSION pooler (port 5432).
# postgresql://postgres.<ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Local Postgres (Docker) fallback — used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hrms_user
DB_PASSWORD=change_me
DB_NAME=hrms_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase Storage (get from Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_BUCKET=hrms-files

# Firebase FCM — fill after Firebase project setup
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Azure (future — replacing Supabase storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
