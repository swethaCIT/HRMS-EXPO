# Copy this file to .env in the same directory and fill in real values.
# The real .env is gitignored and must NEVER be committed.
# NOTE: never commit real secrets here — use placeholders only.

NODE_ENV=development
PORT=3000
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated allowed CORS origins (leave blank to allow all in dev)
CORS_ORIGINS=

# Database
# Supabase Postgres — full connection string from the Supabase dashboard
# (Project → Connect → ORMs/URI), SESSION pooler (port 5432).
# postgresql://postgres.<ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Local Postgres (Docker) fallback — used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hrms_user
DB_PASSWORD=change_me
DB_NAME=hrms_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase Storage (get from Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_BUCKET=hrms-files

# Expo push notifications — optional. Sending works without an access token;
# set one only to opt into Expo's enhanced push security (rejects tokens that
# don't belong to your Expo account). Get it from: expo.dev → Account settings
# → Access tokens.
EXPO_ACCESS_TOKEN=

# Azure (future — replacing Supabase storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Mail (leave/ticket/request emails, password-reset OTPs, onboarding invites).
# Free option: Gmail SMTP relay with an App Password (Google Account → Security →
# 2-Step Verification → App passwords). Leave blank to run in DEV mode, where
# emails are logged to the console instead of sent — nothing breaks, nothing is lost.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# HR Onboard Notify
COMPANY_NAME=HRMS
# Base URL used to build the public onboarding link emailed to candidates.
PUBLIC_BASE_URL=http://localhost:3000
# Signs onboarding link tokens. Falls back to JWT_SECRET when unset.
ONBOARDING_TOKEN_SECRET=
ONBOARDING_TOKEN_EXPIRY_DAYS=7
