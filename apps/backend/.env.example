# Copy this file to .env in the same directory
# This file shows the format — real .env is gitignored and never committed

NODE_ENV=development
PORT=3000
JWT_SECRET=hrms_jwt_secret_Adhi3241@#!_super_secure_key
JWT_EXPIRES_IN=7d

# Database
# Supabase Postgres — full connection string from Supabase dashboard
# (Project → Connect → ORMs/URI), SESSION pooler (port 5432).
# postgresql://postgres.<ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Local Postgres (Docker) fallback — used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hrms_user
DB_PASSWORD=hrms_password
DB_NAME=hrms_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

