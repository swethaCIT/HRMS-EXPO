# Copy this to apps/backend/.env and fill in your real values.
# This file is a TEMPLATE ONLY — never put real secrets here (it is committed to git).

NODE_ENV=development
PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# PostgreSQL — leave DATABASE_URL empty to use the local Docker fallback below
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hrms_user
DB_PASSWORD=hrms_password
DB_NAME=hrms_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase Storage (project settings → API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_BUCKET=hrms-files

# Expo push notifications — optional. Sending works without an access token;
# set one only to opt into Expo's enhanced push security (rejects tokens that
# don't belong to your Expo account). Get it from: expo.dev → Account settings
# → Access tokens.
EXPO_ACCESS_TOKEN=

# Azure (future — replacing Supabase storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
